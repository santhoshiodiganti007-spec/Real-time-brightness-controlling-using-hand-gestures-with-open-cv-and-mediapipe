APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Gesture & Brightness settings
MIN_BRIGHTNESS=10
MAX_BRIGHTNESS=100
SMOOTHING_ALPHA=0.2
MIN_GESTURE_DISTANCE=0.03
MAX_GESTURE_DISTANCE=0.25
UPDATE_THRESHOLD=2.0
DEMO_MODE=false

# MediaPipe Confidence
DETECTION_CONFIDENCE=0.7
TRACKING_CONFIDENCE=0.7
MAX_NUM_HANDS=2

# Database
DATABASE_URL=sqlite:///./touchless_brightness.db
